<Page
    x:Class="TVBoxForWindows.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource DiscoveryBackground}">

    <Page.Resources>
        <!-- 分组卡片 -->
        <Style x:Key="CardPanel" TargetType="StackPanel">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Spacing" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RightSlider" TargetType="Slider">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightCombo" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightToggle" TargetType="ToggleSwitch">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Width" Value="48"/>
        </Style>
        <Style x:Key="RightTextBox" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="SettingsScroll">
        <StackPanel MaxWidth="880" Padding="24" Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/>
            <StackPanel x:Name="SoftwareUpdatePanel" Style="{StaticResource CardPanel}">
                <TextBlock Text="软件更新" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="UpdateStatusText" Text="从公开GitHub稳定版检查更新；下载校验后再安装，保留个人资料。" Style="{StaticResource RowDesc}"/>
                <ProgressBar x:Name="UpdateDownloadProgress" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="查看版本更新" Click="OnViewChanges"/>
                    <Button x:Name="CheckUpdateButton" Content="检查更新" Click="OnCheckUpdate"/>
                    <Button x:Name="DownloadUpdateButton" Content="下载新版本" Visibility="Collapsed" Click="OnDownloadUpdate"/>
                    <Button x:Name="InstallUpdateButton" Content="退出并安装更新" Visibility="Collapsed" Click="OnInstallUpdate"/>
                    <HyperlinkButton Content="版本与下载" NavigateUri="https://github.com/cbdoglolz/tvbox-pc-public/releases/latest"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Style="{StaticResource CardPanel}">
                <TextBlock Text="外观与海报操作" Style="{StaticResource CardTitle}"/>
                <ComboBox x:Name="ThemeCombo" Header="主题" SelectionChanged="OnThemeChanged" HorizontalAlignment="Left">
                    <ComboBoxItem Content="奈飞 · 蓝黑紫"/><ComboBoxItem Content="豆瓣 · 纯白"/>
                </ComboBox>
                <ToggleSwitch x:Name="PosterDetailsToggle" Header="点选作品进入资料与片源详情" IsEnabled="False" OnContent="先看详情" OffContent="先看详情" Toggled="OnPosterDetailsChanged"/>
                <TextBlock Text="海报、片名和列表续播均先进入详情；只有详情页中的播放按钮启动播放。右上角衣服图标可切换主题。" Style="{StaticResource RowDesc}"/>
            </StackPanel>
<StackPanel Style="{StaticResource CardPanel}"><TextBlock Text="自动选源" Style="{StaticResource CardTitle}"/><TextBlock Text="速度优先尽快起播；高清优先最多等待6秒比较首批候选，优先清单分辨率，其次来源画质标记。切换偏好下次选源生效。" Style="{StaticResource RowDesc}"/><ComboBox x:Name="SourcePreferenceSettingsCombo" SelectionChanged="OnSourcePreferenceSettingsChanged"><ComboBoxItem Content="速度优先"/><ComboBoxItem Content="高清优先"/></ComboBox></StackPanel>
            <InfoBar x:Name="StatusInfo" IsOpen="False"/>
            <StackPanel x:Name="MetadataPanel" Style="{StaticResource CardPanel}">
                <TextBlock Text="影视资料与评分（可选）" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="个人TMDB API Key或Read Access Token。不填也能浏览豆瓣和使用普通片源播放；小雅/G-Box高清搜索安排在后续版本接入。凭据使用当前Windows用户加密保存。" Style="{StaticResource RowDesc}"/>
                <PasswordBox x:Name="TmdbKeyBox" Header="TMDB个人Key / Read Token" PlaceholderText="选填；已保存凭据不回显" PasswordRevealMode="Hidden"/>
                <StackPanel Orientation="Horizontal" Spacing="8"><Border x:Name="TmdbSavedBadge" Padding="8,4" CornerRadius="6" BorderThickness="1" BorderBrush="#5580BD90" Visibility="Collapsed"><TextBlock Text="✓ 已保存" Foreground="#FF53BC80" FontWeight="Bold"/></Border><Button Content="保存凭据" Click="OnSaveTmdb"/><Button Content="测试连接" Click="OnTestTmdb"/><Button Content="删除凭据" Click="OnClearTmdb"/><HyperlinkButton Content="申请个人Key" NavigateUri="https://www.themoviedb.org/settings/api"/></StackPanel>
                <TextBlock x:Name="TmdbStatus" TextWrapping="Wrap" Style="{StaticResource RowDesc}"/>
                <CheckBox x:Name="MetadataHintHidden" Content="不再提示配置TMDB" Click="OnMetadataHintHidden"/>
                <ComboBox x:Name="PrimaryRatingCombo" Header="海报主评分" SelectionChanged="OnPrimaryRatingChanged"><ComboBoxItem Content="豆瓣"/><ComboBoxItem Content="TMDB"/></ComboBox>
                <CheckBox x:Name="SecondaryRatingToggle" Content="同时显示其他平台评分" Click="OnSecondaryRatingChanged"/>
                <Button Content="清理影视资料缓存" Click="OnClearMetadataCache"/>
                <TextBlock Text="资料缓存最多约128MB，响应30分钟、详情3天；保留筛选预设、人工关联、收藏和观看进度。" Style="{StaticResource RowDesc}"/>
                <TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB." Style="{StaticResource RowDesc}"/>
                <HyperlinkButton Content="TMDB · 资料与图片来源" NavigateUri="https://www.themoviedb.org/"/>
            </StackPanel>

            <StackPanel Style="{StaticResource CardPanel}">
                <TextBlock Text="界面" Style="{StaticResource CardTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="展开侧边栏"/>
                        <TextBlock Text="始终显示侧边栏中的栏目名称" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="NavigationPaneToggle"
                                  Grid.Column="1"
                                  Style="{StaticResource RightToggle}"
                                  OnContent=""
                                  OffContent=""
                                  Toggled="OnNavigationPaneToggled"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="搜索结果样式"/>
                        <TextBlock Text="切换站点查看，或按站点分组纵向浏览" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="SearchDisplayCombo"
                              Grid.Column="1"
                              MinWidth="160"
                              Style="{StaticResource RightCombo}"
                              SelectionChanged="OnSearchDisplayChanged">
                        <ComboBoxItem Content="站点切换"/>
                        <ComboBoxItem Content="分组纵览"/>
                    </ComboBox>
                </Grid>
            </StackPanel>

            <StackPanel Style="{StaticResource CardPanel}">
                <TextBlock Text="窗口" Style="{StaticResource CardTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="关闭软件时"/>
                        <TextBlock Text="选择点击窗口关闭按钮后的行为" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="CloseBehaviorCombo"
                              Grid.Column="1"
                              MinWidth="180"
                              Style="{StaticResource RightCombo}"
                              SelectionChanged="OnCloseBehaviorChanged">
                        <ComboBoxItem Content="退出软件"/>
                        <ComboBoxItem Content="最小化到系统托盘"/>
                    </ComboBox>
                </Grid>
            </StackPanel>



            <!-- ① 配置 -->
            <StackPanel Style="{StaticResource CardPanel}">
                <TextBlock Text="配置" Style="{StaticResource CardTitle}"/>

                <Grid ColumnSpacing="8" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="点播配置" VerticalAlignment="Center"/>
                    <TextBox x:Name="VodUrlBox" Grid.Row="0" Grid.Column="1"
                             HorizontalAlignment="Stretch" PlaceholderText="http(s)://... 点播配置地址"
                             LostFocus="OnVodUrlLostFocus" KeyDown="OnVodUrlKeyDown"/>
                    <DropDownButton Grid.Row="0" Grid.Column="2" Content="历史" VerticalAlignment="Center">
                        <DropDownButton.Flyout>
                            <Flyout x:Name="VodHistoryFlyout" Placement="Bottom">
                                <ListView x:Name="VodHistoryList" Width="380" MaxHeight="320"
                                          IsItemClickEnabled="True" ItemClick="OnVodHistoryClick" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Desc}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Url}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6"
                                                        Click="OnVodHistoryDelete">
                                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74D;" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="VodLoadButton" Grid.Row="0" Grid.Column="3" Content="加载"
                            VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" Click="OnVodLoad"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="直播配置" VerticalAlignment="Center"/>
                    <TextBox x:Name="LiveUrlBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                             PlaceholderText="TXT / M3U / JSON / TVBox / CatPawOpen 地址"
                             LostFocus="OnLiveUrlLostFocus" KeyDown="OnLiveUrlKeyDown"/>
                    <DropDownButton Grid.Row="1" Grid.Column="2" Content="历史" VerticalAlignment="Center">
                        <DropDownButton.Flyout>
                            <Flyout x:Name="LiveHistoryFlyout" Placement="Bottom">
                                <ListView x:Name="LiveHistoryList" Width="380" MaxHeight="320"
                                          IsItemClickEnabled="True" ItemClick="OnLiveHistoryClick" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Desc}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Url}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6"
                                                        Click="OnLiveHistoryDelete">
                                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE74D;" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="LiveLoadButton" Grid.Row="1" Grid.Column="3" Content="加载"
                            VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" Click="OnLiveLoad"/>

                    <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="当前站点"/>
                        <TextBlock Text="点播默认浏览使用的站点" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="SiteCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                              HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="OnSiteChanged"/>

                    <StackPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="默认解析器"/>
                        <TextBlock Text="需要解析的播放地址默认使用的解析线路" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="ParseCombo" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                              HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="OnParseChanged"/>
                    <TextBox x:Name="ParseUnavailableText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                             HorizontalAlignment="Stretch" Text="当前配置未提供解析线路"
                             IsReadOnly="True" IsEnabled="False" IsTabStop="False" Visibility="Collapsed"/>
                </Grid>
            </StackPanel>

            <!-- ② 播放 -->
            <StackPanel Style="{StaticResource CardPanel}">
                <TextBlock Text="播放" Style="{StaticResource CardTitle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="默认倍速"/>
                        <TextBlock x:Name="SpeedValueText" Text="1x" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <Slider x:Name="SpeedSlider" Grid.Column="1" Width="240" Style="{StaticResource RightSlider}" Minimum="1" Maximum="4"
                            StepFrequency="0.25" TickFrequency="0.5" ValueChanged="OnSpeedChanged"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="默认缩放"/>
                        <TextBlock Text="画面比例适配方式" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="ScaleCombo" Grid.Column="1" MinWidth="160" Style="{StaticResource RightCombo}" SelectionChanged="OnScaleChanged">
                        <ComboBoxItem Content="原始"/>
                        <ComboBoxItem Content="拉伸"/>
                        <ComboBoxItem Content="16:9"/>
                        <ComboBoxItem Content="4:3"/>
                        <ComboBoxItem Content="填充"/>
                    </ComboBox>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="播放超时"/>
                        <TextBlock Text="超过该时长仍无法起播则报错" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="PlayTimeoutCombo" Grid.Column="1" MinWidth="160" Style="{StaticResource RightCombo}" SelectionChanged="OnPlayTimeoutChanged">
                        <ComboBoxItem Content="5 秒"/>
                        <ComboBoxItem Content="10 秒"/>
                        <ComboBoxItem Content="15 秒"/>
                        <ComboBoxItem Content="30 秒"/>
                    </ComboBox>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="自动跳过片头片尾"/>
                        <TextBlock Text="按历史记录中的片头/片尾时间自动跳过" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="SkipToggle" Grid.Column="1" Style="{StaticResource RightToggle}" OnContent="" OffContent="" Toggled="OnSkipToggled"/>
                </Grid>
            </StackPanel>

            <StackPanel Style="{StaticResource CardPanel}">
                <TextBlock Text="片源统计与缓存" Style="{StaticResource CardTitle}"/>
                <TextBlock Text="每个播放会话中，每集首次真正出画面后记一次胜出；同会话手动换源不重复计胜。探测通过不算成功开播。无痕模式不记录。" Style="{StaticResource RowDesc}" TextWrapping="Wrap"/>
                <Button Content="刷新片源统计" Click="OnRefreshSourceStatistics"/>
                <TextBlock Text="广告标记统计 · 按作品/季统计，非广告段数量" FontWeight="SemiBold"/><TextBlock x:Name="AdStatisticsText" TextWrapping="Wrap"/>
                <TextBlock x:Name="SourceStatisticsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                <ToggleSwitch x:Name="CacheAutoToggle" Header="后台自动清理缓存" Toggled="OnCacheSettingsChanged"/>
                <ComboBox x:Name="CacheLimitCombo" Header="缓存上限" SelectionChanged="OnCacheLimitChanged">
                    <ComboBoxItem Content="256 MiB"/><ComboBoxItem Content="512 MiB"/><ComboBoxItem Content="1024 MiB（默认）"/><ComboBoxItem Content="2048 MiB"/>
                </ComboBox>
                <TextBlock Text="每5分钟检查；超过上限按旧到新清理至80%，保护最近2分钟写入。仅清理图片、临时文件和片源测试缓存；收藏、观看进度、设置、统计、当天发现保留。影视资料库另有128 MiB维护规则。片源结果有效期7天，点击播放页刷新可强制重测。" Style="{StaticResource RowDesc}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- ③ 弹幕 -->
            <StackPanel Style="{StaticResource CardPanel}">
                <TextBlock Text="弹幕" Style="{StaticResource CardTitle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="启用弹幕"/>
                        <TextBlock Text="开启后自动搜索并显示本片本集弹幕；切集自动更新" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="DanmakuLoadToggle" Grid.Column="1" Style="{StaticResource RightToggle}" OnContent="" OffContent="" Toggled="OnDanmakuLoadToggled"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="自动搜索与加载"/>
                        <TextBlock Text="优先站点自带弹幕，其次弹弹play聚合；失败后尝试B站" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="DanmakuAutoToggle" Grid.Column="1" Style="{StaticResource RightToggle}" OnContent="" OffContent="" Toggled="OnDanmakuAutoToggled"/>
                </Grid>

                <StackPanel Spacing="6">
                    <ToggleSwitch x:Name="DanmakuRelayToggle" Header="自动使用弹弹play聚合（公共代理）" Toggled="OnDanmakuRelayToggled"/>
                    <TextBlock Text="默认开启，无需账号或Key。通过uosc_danmaku维护的公共代理查询；有缓存和限流，服务可能临时不可用。启用自动弹幕后会发送片名和集数；关闭此项则使用B站或自定义服务。" Style="{StaticResource RowDesc}" TextWrapping="Wrap"/>
                    <HyperlinkButton Content="弹幕数据：弹弹play开放弹幕网络" NavigateUri="https://www.dandanplay.com/"/>
                    <HyperlinkButton Content="公共代理来源与说明" NavigateUri="https://github.com/Tony15246/uosc_danmaku"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="多平台弹幕服务（可选）"/>
                    <TextBlock Text="留空自动使用弹弹play聚合与B站。兼容弹弹play的服务可提供优酷、腾讯等弹幕；启用后会向所选服务发送片名和集数。服务覆盖和可用性以实际返回为准。" Style="{StaticResource RowDesc}" TextWrapping="Wrap"/>
                    <TextBox x:Name="DanmakuApiBox" PlaceholderText="https://你的服务/api/v2/"/>
                    <Button Content="保存弹幕服务" Click="OnSaveDanmakuApi"/>
                    <TextBlock x:Name="DanmakuApiStatus" TextWrapping="Wrap" Style="{StaticResource RowDesc}"/>
                    <ToggleSwitch x:Name="DanmakuBiliToggle" Header="B站正片弹幕（无需个人Key）" Toggled="OnDanmakuBiliToggled"/>
                    <TextBlock Text="附加弹幕服务（按列表顺序自动尝试）" FontWeight="SemiBold"/>
                    <TextBlock Text="公共代理不保证覆盖每部片子。弹弹play官方API需要自行申请AppId/AppSecret；自建聚合服务可对接更多平台。地址和密钥仅加密保存在本机。" Style="{StaticResource RowDesc}"/>
                    <StackPanel x:Name="DanmakuServicesList" Spacing="6"/>
                    <ComboBox x:Name="DanmakuServiceType" Header="服务类型" SelectedIndex="0" SelectionChanged="OnDanmakuServiceTypeChanged"><ComboBoxItem Content="自定义兼容聚合服务"/><ComboBoxItem Content="弹弹play官方API"/></ComboBox>
                    <TextBox x:Name="DanmakuServiceName" Header="显示名称" MaxLength="80"/>
                    <TextBox x:Name="DanmakuServiceUrl" Header="服务地址" PlaceholderText="https://你的服务/api/v2/"/>
                    <TextBox x:Name="DanmakuOfficialAppId" Header="官方AppId（仅官方API需要）"/>
                    <PasswordBox x:Name="DanmakuOfficialSecret" Header="官方AppSecret" PasswordRevealMode="Hidden"/>
                    <Button Content="添加并启用" Click="OnAddDanmakuService"/>
                    <StackPanel Orientation="Horizontal" Spacing="4"><HyperlinkButton Content="官方API申请说明" NavigateUri="https://doc.dandanplay.com/open/"/><HyperlinkButton Content="自建聚合：danmaku" NavigateUri="https://github.com/tamersunion/danmaku"/><HyperlinkButton Content="自建聚合：danmuapi" NavigateUri="https://github.com/canmo101/danmuapi"/></StackPanel>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="透明度" VerticalAlignment="Center"/>
                    <Slider x:Name="DanmakuAlphaSlider" Grid.Column="1" Width="240" Style="{StaticResource RightSlider}" Minimum="10" Maximum="100"
                            StepFrequency="5" ValueChanged="OnDanmakuAlphaChanged"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="字号" VerticalAlignment="Center"/>
                    <Slider x:Name="DanmakuSizeSlider" Grid.Column="1" Width="240" Style="{StaticResource RightSlider}" Minimum="12" Maximum="48"
                            StepFrequency="2" ValueChanged="OnDanmakuSizeChanged"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="速度" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DanmakuSpeedCombo" Grid.Column="1" MinWidth="160" Style="{StaticResource RightCombo}" SelectionChanged="OnDanmakuSpeedChanged">
                        <ComboBoxItem Content="慢"/>
                        <ComboBoxItem Content="中"/>
                        <ComboBoxItem Content="快"/>
                    </ComboBox>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="显示区域" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DanmakuAreaCombo" Grid.Column="1" MinWidth="160" Style="{StaticResource RightCombo}" SelectionChanged="OnDanmakuAreaChanged">
                        <ComboBoxItem Content="1/4 屏"/><ComboBoxItem Content="1/3 屏"/>
                        <ComboBoxItem Content="半屏"/>
                        <ComboBoxItem Content="3/4 屏"/>
                        <ComboBoxItem Content="全屏"/>
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- ④ 网络 -->
            <StackPanel Style="{StaticResource CardPanel}">
                <TextBlock Text="网络" Style="{StaticResource CardTitle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="安全 DNS（DoH）"/>
                        <TextBlock Text="使用 DNS over HTTPS 解析域名，默认关闭" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="DohCombo" Grid.Column="1" MinWidth="200" Style="{StaticResource RightCombo}" DisplayMemberPath="Name" SelectionChanged="OnDohChanged"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="代理"/>
                        <TextBlock Text="如 http://127.0.0.1:7890 或 socks5://...，留空不使用" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <TextBox x:Name="ProxyBox" Grid.Column="1" MinWidth="280" Style="{StaticResource RightTextBox}" PlaceholderText="留空不使用" LostFocus="OnProxyLost"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="User-Agent"/>
                        <TextBlock Text="全局默认请求 UA" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <TextBox x:Name="UaBox" Grid.Column="1" MinWidth="280" Style="{StaticResource RightTextBox}" LostFocus="OnUaLost"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="站点超时"/>
                        <TextBlock Text="站点数据请求的超时时长" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ComboBox x:Name="SiteTimeoutCombo" Grid.Column="1" MinWidth="160" Style="{StaticResource RightCombo}" SelectionChanged="OnSiteTimeoutChanged">
                        <ComboBoxItem Content="5 秒"/>
                        <ComboBoxItem Content="10 秒"/>
                        <ComboBoxItem Content="15 秒"/>
                        <ComboBoxItem Content="30 秒"/>
                    </ComboBox>
                </Grid>
            </StackPanel>

            <!-- ⑤ 隐私与数据 -->
            <StackPanel Style="{StaticResource CardPanel}">
                <TextBlock Text="隐私与数据" Style="{StaticResource CardTitle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="无痕模式"/>
                        <TextBlock Text="开启后不记录观看历史" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="IncognitoToggle" Grid.Column="1" Style="{StaticResource RightToggle}" OnContent="" OffContent="" Toggled="OnIncognitoToggled"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="清空缓存"/>
                        <TextBlock x:Name="CacheSizeText" Text="计算中..." Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <Button x:Name="ClearCacheButton" Grid.Column="1" Style="{StaticResource RightButton}" Content="清空" Click="OnClearCache"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="备份与还原"/>
                        <TextBlock Text="将设置、配置历史、观看记录与收藏打包为 zip，或从备份 zip 恢复" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BackupButton" Content="备份" Click="OnBackup"/>
                        <Button x:Name="RestoreButton" Content="还原" Click="OnRestore"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ⑥ 关于 -->
            <StackPanel Style="{StaticResource CardPanel}">
                <TextBlock Text="关于" Style="{StaticResource CardTitle}"/>
                <Image x:Name="TmdbLogo" Height="20" Width="47" HorizontalAlignment="Left" Stretch="Uniform"/>
                <TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB." Style="{StaticResource RowDesc}"/>

                <TextBlock x:Name="VersionText" Text="TVBox PC"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="FfmpegStatusText" Text="FFmpeg 状态检测中..."/>
                        <StackPanel x:Name="FfmpegGuidePanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource RowDesc}"
                                       Text="未检测到兼容的 FFmpeg 解码库，无法播放。正式发布包已经内置 FFmpeg 8.1 LGPL shared win64 动态库；出现此提示通常表示安装或解压不完整，请重新下载安装包或完整解压便携包。"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="OpenFfmpegButton" Grid.Column="1" Content="打开 FFmpeg 目录" Style="{StaticResource RightButton}" VerticalAlignment="Top" Click="OnOpenFfmpeg"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="允许局域网访问"/>
                        <TextBlock Text="默认仅本机可访问；开启后同一局域网设备可推送配置和播放地址" Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="LanServerToggle"
                                  Grid.Column="1"
                                  Style="{StaticResource RightToggle}"
                                  OnContent=""
                                  OffContent=""
                                  Toggled="OnLanServerToggled"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="本地服务器"/>
                        <TextBlock x:Name="ServerAddrText" Text="" Style="{StaticResource RowDesc}"/>
                        <TextBlock x:Name="ServerLanText" Text="" Style="{StaticResource RowDesc}"/>
                        <TextBlock Text="开启局域网访问后，手机与电脑在同一可信网络时可打开局域网地址进行推送。"
                                   Style="{StaticResource RowDesc}"/>
                    </StackPanel>
                    <Button x:Name="CopyAddrButton" Grid.Column="1" Content="复制地址" Style="{StaticResource RightButton}" VerticalAlignment="Top" Click="OnCopyAddr"/>
                </Grid>

                <TextBlock Style="{StaticResource RowDesc}"
                           Text="基于TVBox for Windows继续开发，工程遵循GPL-3.0。组件包括Flyleaf/FFmpeg、Jint、AngleSharp、Microsoft.Data.Sqlite、SQLitePCLRaw及Windows App SDK，各自许可与完整声明见包内THIRD-PARTY-NOTICES.md和docs/licenses。"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
