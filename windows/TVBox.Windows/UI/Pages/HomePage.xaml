<Page x:Class="TVBoxForWindows.UI.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:TVBoxForWindows.UI.Controls"
      NavigationCacheMode="Required" Background="{ThemeResource DiscoveryBackground}">
    <Page.Resources>
        <LinearGradientBrush x:Key="DiscoverySelectionGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7551B6" Offset="0"/><GradientStop Color="#453273" Offset="0.56"/><GradientStop Color="#8B5AD7" Offset="1"/></LinearGradientBrush>
        <Style x:Key="DiscoveryTabItem" TargetType="ListViewItem">
            <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="2,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                <Grid Background="Transparent" CornerRadius="9">
                    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverFill.Opacity" Value="0.12"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverFill.Opacity" Value="0.20"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="TabContent.Foreground" Value="White"/></VisualState.Setters></VisualState><VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="TabContent.Foreground" Value="White"/></VisualState.Setters></VisualState><VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="TabContent.Foreground" Value="White"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"/>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <Border x:Name="HoverFill" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0" CornerRadius="9"/>
                    <Border Background="{StaticResource DiscoverySelectionGradient}" BorderBrush="#B899E4" BorderThickness="1" CornerRadius="9" Visibility="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}"/>
                    <ContentPresenter x:Name="TabContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <DataTemplate x:Key="RecommendationCard"><controls:WorkPosterCard/></DataTemplate>
        <DataTemplate x:Key="WorkRow"><controls:WorkPosterCard Compact="True"/></DataTemplate>
    </Page.Resources>
    <Grid x:Name="HomeRoot" Background="{ThemeResource DiscoveryBackground}" Padding="24,18,24,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <Image Visibility="Collapsed" x:Name="FeedLogo" Width="110" Height="32" Stretch="Uniform" VerticalAlignment="Center"/>
                    <ListView x:Name="ProviderTabs" Height="46" SelectionChanged="OnProviderChanged" SelectionMode="Single" ItemContainerStyle="{StaticResource DiscoveryTabItem}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                        <ListViewItem AutomationProperties.Name="豆瓣"><Image x:Name="DoubanTabLogo" Width="85" Height="24" Stretch="Uniform" ToolTipService.ToolTip="豆瓣热播与推荐"/></ListViewItem><ListViewItem AutomationProperties.Name="Netflix标签"><Image x:Name="NetflixTabLogo" Width="110" Height="28" Stretch="Uniform" ToolTipService.ToolTip="Netflix标签片库：来自豆瓣资料，非Netflix官方榜单"/></ListViewItem>
                        <ListViewItem AutomationProperties.Name="TMDB目录"><Image x:Name="TmdbTabLogo" Width="86" Height="24" Stretch="Uniform"/></ListViewItem>
                    </ListView>


                </StackPanel>
                <TextBlock x:Name="SourceCountText" Text="按豆瓣推荐选片，点开后自动寻找可播放来源"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="组合筛选" Click="OnFilters"/></StackPanel>
        </Grid>
        <Button x:Name="ContinueButton" Grid.Row="1" Visibility="Collapsed" Click="OnContinue" MaxWidth="720" HorizontalAlignment="Left"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
            <ListView x:Name="CategoryTabs" Height="46" SelectionMode="Single" ItemContainerStyle="{StaticResource DiscoveryTabItem}" SelectionChanged="OnCategoryChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
            </ListView>
            <ProgressRing x:Name="Busy" Width="24" Height="24" IsActive="False"/>
            <TextBlock x:Name="FeedStatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="3"><controls:HomeFilterBar x:Name="HomeFilters" Visibility="Collapsed"/><controls:CatalogFacetChips x:Name="HomeChips"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="PinnedPresets" Orientation="Horizontal" Spacing="8"/></ScrollViewer><InfoBar x:Name="FeedError" IsOpen="False" Severity="Warning" Title="影视推荐" IsClosable="True"/></StackPanel>
        <Grid Grid.Row="4">
            <GridView x:Name="PosterWall" IsItemClickEnabled="False" ItemClick="OnPosterClick" SelectionMode="None"
                      ItemTemplate="{StaticResource RecommendationCard}" Padding="0,0,0,12">
                <GridView.Header>
                    <StackPanel Spacing="18" Margin="5,4,5,18">
                        <Border Style="{StaticResource DiscoveryPanel}">
                            <Grid Height="256" ColumnSpacing="20" Padding="14,12,14,32" CornerRadius="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="HeroArtworkColumn" Width="156"/></Grid.ColumnDefinitions>
                                <controls:PosterImage x:Name="HeroBackdrop" Grid.ColumnSpan="2" ArtworkKind="backdrop" Decorative="True" Opacity="0.62" IsHitTestVisible="False"/>
                                <Border Grid.ColumnSpan="2" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.25"><GradientStop Color="#F00D1024" Offset="0"/><GradientStop Color="#D9141633" Offset="0.5"/><GradientStop Color="#730D1024" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                <ProgressBar x:Name="HeroProgress" Grid.ColumnSpan="2" Height="3" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Top" Margin="0,-8,0,0" IsHitTestVisible="False"/>
                                <StackPanel x:Name="HeroPages" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-24"/>

                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="DailyHeading" Text="今日发现" Foreground="#CCFFFFFF"/>
                                    <controls:WorkTitleArt x:Name="HeroTitle" TextForeground="White" MinHeight="48" Height="60" MaxHeight="60"/>
                                    <TextBlock x:Name="HeroFacts" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="#DDFFFFFF"/>
                                    <TextBlock x:Name="HeroOverview" FontSize="12" Foreground="#EEFFFFFF" TextWrapping="Wrap" MaxLines="2"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="HeroPlay" Content="查看资料与片源" Click="OnHeroPlay" IsEnabled="False" Style="{StaticResource DiscoveryPrimaryButton}"/>

                                        <Button Content="搜索高清源" Click="OnHd"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="HeroArtwork" Grid.Column="1" Width="130" Spacing="0" HorizontalAlignment="Right"><controls:PosterImage x:Name="HeroPoster" Width="130" Height="182"/><controls:RatingStrip x:Name="HeroScores"/></StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="ContinuePanel" Visibility="Collapsed" Spacing="8">
                            <Grid><TextBlock Text="继续观看" Style="{StaticResource SectionTitleTextStyle}"/><Button Click="OnClearContinue" HorizontalAlignment="Right" Padding="6" ToolTipService.ToolTip="清空继续观看，保留历史进度"><SymbolIcon Symbol="Delete"/></Button></Grid>
                            <ListView x:Name="ContinueRows" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnContinueCard" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled">
                                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                                <ListView.ItemTemplate><DataTemplate><Grid Width="280" Height="174" CornerRadius="12" Margin="0,0,8,4" Background="#192037">
                                    <controls:PosterImage Source="{Binding Image}" Decorative="True"/>
                                    <Button Content="×" Width="28" Height="28" Padding="0" CornerRadius="14" Background="#C01C1C2E" BorderBrush="#60FFFFFF" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Click="OnRemoveContinue" ToolTipService.ToolTip="从继续观看移除，保留历史进度"/>
                                    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00080A12" Offset="0.15"/><GradientStop Color="#EC080A12" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                    <Border Background="#C0080A12" CornerRadius="5" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9"><TextBlock Text="{Binding Timestamp}" Foreground="White" FontSize="11"/></Border>
                                    <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,14" Spacing="3"><TextBlock Text="{Binding Episode}" Foreground="#DDFFFFFF" FontSize="11"/><TextBlock Text="{Binding Title}" Foreground="White" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding EpisodeTitle}" Foreground="#BBFFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Progress}" Foreground="#CCFFFFFF" FontSize="11"/></StackPanel>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="3" VerticalAlignment="Bottom" Margin="10,0,10,6"/>
                                </Grid></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                        <TextBlock x:Name="ChannelHeading" Text="频道海报墙 · 向下滚动继续加载" Style="{StaticResource SectionTitleTextStyle}"/>
                    </StackPanel>
                </GridView.Header>
            </GridView>
            <controls:ScrollReturnButtons x:Name="ReturnButtons"/>
            <TextBlock x:Name="EmptyText" Text="正在获取豆瓣推荐…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>
        <Button x:Name="MoreButton" Grid.Row="5" Content="加载更多推荐" Click="OnMore" HorizontalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</Page>
