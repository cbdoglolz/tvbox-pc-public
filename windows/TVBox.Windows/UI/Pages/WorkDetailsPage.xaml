<Page x:Class="TVBoxForWindows.UI.Pages.WorkDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:TVBoxForWindows.UI.Controls" Background="{ThemeResource DiscoveryBackground}">
    <Page.Resources>
        <DataTemplate x:Key="RelatedCard"><StackPanel Width="138" Spacing="6" Margin="4,4,4,12"><controls:PosterImage Work="{Binding}" Width="138" Height="194"/><controls:RatingStrip/><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Year}" Foreground="{ThemeResource DiscoveryMuted}" FontSize="11"/></StackPanel></DataTemplate>
    </Page.Resources>
    <Grid>
        <ScrollViewer x:Name="DetailScroll" ViewChanged="OnDetailScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Padding="0,0,0,32">
                <Grid x:Name="DetailHero" Height="380" Background="#121426" CornerRadius="0,0,18,18">
                    <controls:PosterImage x:Name="DetailBackdrop" Decorative="True" Opacity="0.8"/>
                    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1"><GradientStop Color="#9E090C18" Offset="0"/><GradientStop Color="#26090C18" Offset="0.3"/><GradientStop Color="#ED090C18" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                    <StackPanel Spacing="12" VerticalAlignment="Bottom" Margin="32,58,32,28"><controls:WorkTitleArt x:Name="WorkTitle" TextForeground="White" Height="126" MaxHeight="126"/><TextBlock x:Name="HeroSummary" Foreground="#F0FFFFFF" FontSize="14" TextWrapping="Wrap" MaxLines="3" MaxWidth="840" HorizontalAlignment="Left"/></StackPanel>
                </Grid>
                <StackPanel Spacing="22" Padding="24,0,24,0">
                    <InfoBar x:Name="Status" IsOpen="False" IsClosable="True"/>
                    <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <controls:PosterImage x:Name="Poster" Width="156" Height="220" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="10">
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Facts" Orientation="Horizontal" Spacing="6"/></ScrollViewer>
                            <StackPanel x:Name="Ratings" Spacing="6"/>
                            <TextBlock x:Name="ResumePosition" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="▶ 播放 / 续播" Click="OnPlay" Style="{StaticResource DiscoveryPrimaryButton}"/><Button x:Name="Favorite" Click="OnFavorite"/><Button x:Name="WatchStateButton" Click="OnWorkWatchState" Content="观看状态"/><Button Content="搜索高清源" Click="OnHd" ToolTipService.ToolTip="只检测已开启的国际高清适配器，画质以实际解码为准"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="Matches" DisplayMemberPath="Label" PlaceholderText="核对可能的TMDB作品" Visibility="Collapsed" MaxWidth="300"/><Button x:Name="Associate" Content="确认关联" Click="OnAssociate" Visibility="Collapsed"/></StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="SeasonsPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock Text="季与单集" Style="{StaticResource SectionTitleTextStyle}"/>
                        <ListView x:Name="Season" SelectionMode="Single" SelectionChanged="OnSeasonChanged" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                            <ListView.ItemTemplate><DataTemplate><StackPanel Width="124" Margin="3,3,8,8" Spacing="6"><controls:PosterImage Source="{Binding PreviewImage}" Width="124" Height="174"/><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" FontWeight="SemiBold"/></StackPanel></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EpisodeStatus" TextWrapping="Wrap" Foreground="{ThemeResource DiscoveryMuted}"/>
                        <ListView x:Name="Episodes" IsItemClickEnabled="True" ItemClick="OnEpisodeClick" SelectionMode="None" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                            <ListView.ItemTemplate><DataTemplate><StackPanel Width="290" Margin="0,0,10,10" Spacing="7"><Grid Height="163" CornerRadius="12" Background="#191E30"><controls:PosterImage Source="{Binding PreviewImage}" FallbackSource="{Binding FallbackImage}" Decorative="True"/>
                                <Button Click="OnEpisodeWatchState" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Background="#B0080B18" Foreground="White"><StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="{Binding StateGlyph}" Foreground="{Binding StateColor}" FontSize="13"/><TextBlock Text="{Binding StateLabel}" FontSize="11"/></StackPanel></Button>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding ResumeLabel}" Foreground="White" FontWeight="SemiBold"/><Button Content="▶ 继续播放" Click="OnResumeEpisode" Background="#AA171226" Foreground="White" HorizontalAlignment="Center"/></StackPanel><Border Background="#AD080B18" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="5" Padding="7,3" Margin="8"><TextBlock Text="{Binding Code}" Foreground="White"/></Border></Grid><TextBlock Text="{Binding Heading}" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap"/><TextBlock Text="{Binding Overview}" TextWrapping="Wrap" MaxLines="3" FontSize="12" Foreground="{ThemeResource DiscoveryMuted}"/><TextBlock Text="{Binding Facts}" TextWrapping="Wrap" FontSize="11" Foreground="#25AAC5"/></StackPanel></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <StackPanel x:Name="CompaniesPanel" Spacing="10" Visibility="Collapsed"><TextBlock Text="出品与播出" Style="{StaticResource SectionTitleTextStyle}"/>
                        <GridView x:Name="Companies" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCompanyClick" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"><GridView.ItemTemplate><DataTemplate><StackPanel Width="144" Margin="3,3,12,12" Spacing="5"><Border Background="#FFE6E7EC" CornerRadius="12" Padding="12"><Grid Width="110" Height="50"><controls:PosterImage Source="{Binding Logo}" ImageStretch="Uniform" Decorative="True"/><TextBlock Text="{Binding LogoText}" Foreground="#303348" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"/></Grid></Border><TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxLines="2"/><TextBlock Text="{Binding Role}" FontSize="11" Foreground="{ThemeResource DiscoveryMuted}"/></StackPanel></DataTemplate></GridView.ItemTemplate></GridView>
                    </StackPanel>
                    <Border Style="{StaticResource DiscoveryPanel}"><StackPanel Spacing="12"><TextBlock Text="剧情简介" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock x:Name="Overview" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock x:Name="Credits" TextWrapping="Wrap" Foreground="{ThemeResource DiscoveryMuted}"/></StackPanel></Border>
                    <TextBlock Text="导演与演员 · 点击头像查看参与作品" Style="{StaticResource SectionTitleTextStyle}"/>
                    <GridView x:Name="CastWall" IsItemClickEnabled="True" ItemClick="OnPersonClick" SelectionMode="None" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"><GridView.ItemTemplate><DataTemplate><StackPanel Width="116" Spacing="7" Margin="4,4,4,14"><Border CornerRadius="12"><controls:PosterImage Source="{Binding Portrait}" Width="116" Height="150"/></Border><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RoleLabel}" FontSize="11" Foreground="{ThemeResource DiscoveryMuted}" TextWrapping="Wrap" MaxLines="3"/></StackPanel></DataTemplate></GridView.ItemTemplate></GridView>
                    <Expander x:Name="SourceExpander" Header="作品资料与播放线路" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><TextBlock x:Name="ExtraFacts" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><Button x:Name="FindSources" Content="查找普通线路与选集" Click="OnFindSources" HorizontalAlignment="Left"/><TextBlock x:Name="SourceStatus" TextWrapping="Wrap"/><StackPanel x:Name="Sources" Spacing="8"/><TextBlock Text="国际来源由独立适配器探测；小雅/G-Box/WebDAV尚未接入。" Foreground="{ThemeResource DiscoveryMuted}"/></StackPanel></Expander>
                    <StackPanel x:Name="CollectionPanel" Spacing="10" Visibility="Collapsed"><TextBlock x:Name="CollectionHeading" Text="同系列作品" Style="{StaticResource SectionTitleTextStyle}"/><GridView x:Name="CollectionWall" ItemTemplate="{StaticResource RelatedCard}" IsItemClickEnabled="True" ItemClick="OnSimilarClick" SelectionMode="None" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/></StackPanel>
                    <StackPanel x:Name="VersionsPanel" Spacing="10" Visibility="Collapsed"><TextBlock Text="相关版本 · 不同年份为不同作品，请核对" Style="{StaticResource SectionTitleTextStyle}"/><GridView x:Name="VersionsWall" ItemTemplate="{StaticResource RelatedCard}" IsItemClickEnabled="True" ItemClick="OnSimilarClick" SelectionMode="None" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"/></StackPanel>
                    <TextBlock Text="相似推荐" Style="{StaticResource SectionTitleTextStyle}"/>
                    <TextBlock x:Name="SimilarStatus" Text="优先同类型作品，再扩展相关题材" TextWrapping="Wrap" Foreground="{ThemeResource DiscoveryMuted}"/>
                    <GridView x:Name="Similar" ItemTemplate="{StaticResource RelatedCard}" IsItemClickEnabled="True" ItemClick="OnSimilarClick" SelectionMode="None" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"/>
                    <Button x:Name="MoreSimilar" Content="继续推荐 ↓" Click="OnMoreSimilar" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <controls:ScrollReturnButtons x:Name="ReturnButtons" Margin="0,68,18,0"/>
        <Grid Height="64" VerticalAlignment="Top" Padding="16,6" Background="{ThemeResource DiscoveryBackground}">
            <Button Content="← 返回" Click="OnBack" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <controls:WorkTitleArt x:Name="StickyTitle" Visibility="Collapsed" MinHeight="38" Height="46" MaxHeight="46" Width="220" HorizontalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Page>
