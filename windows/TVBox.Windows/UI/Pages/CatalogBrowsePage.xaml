<Page x:Class="TVBoxForWindows.UI.Pages.CatalogBrowsePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:TVBoxForWindows.UI.Controls" NavigationCacheMode="Required" Background="{ThemeResource DiscoveryBackground}">
    <Page.Resources>
        <DataTemplate x:Key="WorkCard"><controls:WorkPosterCard/></DataTemplate>
        <DataTemplate x:Key="WorkRow"><controls:WorkPosterCard Compact="True"/></DataTemplate>
    </Page.Resources>
    <Grid Padding="20,12,20,10" RowSpacing="6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="←" Click="OnBackToOrigin" ToolTipService.ToolTip="返回来源页面"/><TextBlock x:Name="PageTitle" Text="影视目录" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
            <ComboBox x:Name="ProviderCombo" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnProviderChanged" MinWidth="120" AutomationProperties.Name="资料目录提供方"><ComboBoxItem Content="豆瓣目录"/><ComboBoxItem Content="TMDB目录"/></ComboBox>
            <Button Grid.Column="2" Content="更多筛选 ▾"><Button.Flyout><Flyout Placement="Bottom" Opening="OnFiltersOpening"><Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="MaxWidth" Value="920"/><Setter Property="Padding" Value="12"/></Style></Flyout.FlyoutPresenterStyle><ScrollViewer x:Name="FilterScroll" MaxHeight="380" HorizontalScrollBarVisibility="Disabled"><controls:CatalogFilterBar x:Name="Filters"/></ScrollViewer></Flyout></Button.Flyout></Button>
            <Button Grid.Column="3" Content="我的筛选">
                <Button.Flyout><Flyout><StackPanel Width="280" Spacing="8">
                    <ComboBox x:Name="PresetCombo" PlaceholderText="选择已保存筛选" DisplayMemberPath="Name" SelectionChanged="OnPresetChanged" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="PresetName" PlaceholderText="预设名称" MaxLength="60"/>
                    <CheckBox x:Name="PresetPinned" Content="固定到首页"/>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存/更新" Click="OnSavePreset"/><Button Content="删除预设" Click="OnDeletePreset"/></StackPanel>
                </StackPanel></Flyout></Button.Flyout>
            </Button>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="SearchScopeCombo" SelectedIndex="0" SelectionChanged="OnSearchScopeChanged" AutomationProperties.Name="目录搜索范围"><ComboBoxItem Content="当前片库"/><ComboBoxItem Content="全部影视 · 保留筛选"/></ComboBox>
            <AutoSuggestBox x:Name="KeywordBox" Grid.Column="1" QueryIcon="Find" PlaceholderText="在当前分类搜索，关键词和条件可叠加" TextChanged="OnKeywordChanged" QuerySubmitted="OnSearchSubmitted"/>
            <Button Grid.Column="2" Content="刷新" Click="OnRefresh"/>
            <Button Grid.Column="3" Content="资源搜索" Click="OnAdvancedSearch" ToolTipService.ToolTip="高级：按原资源站查看原始结果"/>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="8">
            <ListView x:Name="ChannelTabs" Height="44" SelectionMode="Single" SelectionChanged="OnChannelChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                <x:String>推荐</x:String><x:String>热门</x:String><x:String>最新</x:String><x:String>高分</x:String>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="SearchField" Visibility="Collapsed" Header="搜索字段" SelectedIndex="0" ToolTipService.ToolTip="当前目录支持片名；演员/导演远程检索尚未接入，不会冒充片名搜索">
                    <ComboBoxItem Content="片名"/><ComboBoxItem Content="演员 · 暂未接入" IsEnabled="False"/><ComboBoxItem Content="导演 · 暂未接入" IsEnabled="False"/>
                </ComboBox>
                <Button Content="网格 / 列表" Click="OnViewMode" VerticalAlignment="Bottom"/>
                <controls:SortDirectionButton x:Name="QuickDirection" VerticalAlignment="Bottom"/>
            </StackPanel>
            <controls:CatalogFacetChips x:Name="SelectedConditions"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="3">
            <TextBlock x:Name="ResultStatus" TextWrapping="Wrap" FontSize="12" MaxLines="2"/>
            <TextBlock x:Name="ScopeStatus" TextWrapping="Wrap" FontSize="11" MaxLines="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <InfoBar x:Name="OptionalHint" IsOpen="False" Title="TMDB资料为可选功能" Message="可在设置中选填个人Key，获得TMDB评分与详情关联。不填仍可用普通片源看片。" Severity="Informational">
                <InfoBar.Content><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="去设置" Click="OnSettings"/><Button Content="不再提示" Click="OnNeverHint"/></StackPanel></InfoBar.Content>
            </InfoBar>
        </StackPanel>
        <Grid Grid.Row="4">
            <GridView x:Name="PosterWall" ItemTemplate="{StaticResource WorkCard}" SelectionMode="None" IsItemClickEnabled="False" ItemClick="OnPosterClick"/>
            <controls:ScrollReturnButtons x:Name="ReturnButtons"/>
            <TextBlock x:Name="EmptyText" Text="正在查询…" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <ProgressRing x:Name="Busy" Width="20" Height="20" IsActive="False"/>
            <Button x:Name="MoreButton" Content="继续补全 / 加载更多" Click="OnMore"/>
            <Button x:Name="RemoveButton" Content="取消所选作品收藏" Visibility="Collapsed" Click="OnRemove"/>
            <Button x:Name="ClearHistoryButton" Content="清空历史…" Visibility="Collapsed" Click="OnClearHistory"/>
        </StackPanel>
    </Grid>
</Page>
